{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-maker-designer.dev/schemas/set.schema.json",
  "title": "Set",
  "description": "An expansion / product containing cards. May carry a design budget used by the completeness view.",
  "type": "object",
  "required": ["schemaVersion", "code", "gameId", "name"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "code": { "type": "string", "pattern": "^[a-z0-9]+$" },
    "gameId": { "type": "string" },
    "name": { "type": "string" },
    "releaseOrder": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["draft", "review", "released", "archived"] },
    "summary": { "type": "string" },
    "design": {
      "type": "object",
      "properties": {
        "goals": { "type": "array", "items": { "type": "string" } },
        "budget": {
          "type": "object",
          "description": "Planned card counts keyed by card type id",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "cards": {
      "type": "array",
      "description": "Inlined card documents (used by bundle export and the example game)",
      "items": { "$ref": "https://game-maker-designer.dev/schemas/card.schema.json" }
    }
  },
  "additionalProperties": false
}
