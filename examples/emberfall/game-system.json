{
  "$schema": "../../schemas/game-system.schema.json",
  "schemaVersion": "1.0.0",
  "id": "emberfall",
  "version": "0.4.0",
  "name": "Emberfall",
  "summary": "A two-player duel between the houses of Ember and Ash. Burn down the enemy hero before your own fire goes out.",

  "players": { "min": 2, "max": 2, "mode": "competitive", "teams": false },

  "vocabularies": {
    "traits": ["Soldier", "Mystic", "Scout", "Beast", "Relic"],
    "rarities": ["common", "uncommon", "rare"],
    "factions": [
      { "id": "ember", "name": "Ember", "color": "#c0392b", "icon": "flame" },
      { "id": "ash", "name": "Ash", "color": "#5d6d7e", "icon": "cinder" },
      { "id": "neutral", "name": "Neutral", "color": "#8d8378", "icon": "circle" }
    ]
  },

  "resources": [
    {
      "id": "ember",
      "name": "Ember",
      "start": 0,
      "min": 0,
      "max": null,
      "carryOver": false,
      "icon": "flame"
    }
  ],

  "counters": [
    { "id": "damage", "name": "Damage", "visual": "pip-red" },
    { "id": "charge", "name": "Charge", "visual": "pip-blue", "max": 5 }
  ],

  "zones": [
    { "id": "deck",    "name": "Deck",     "scope": "player", "visibility": "none",   "ordered": true,  "faceDown": true },
    { "id": "hand",    "name": "Hand",     "scope": "player", "visibility": "owner",  "ordered": false, "maxSize": null },
    { "id": "play",    "name": "In Play",  "scope": "player", "visibility": "public", "ordered": false, "supportsAttachments": true },
    { "id": "discard", "name": "Discard",  "scope": "player", "visibility": "public", "ordered": true },
    { "id": "removed", "name": "Out of Play", "scope": "shared", "visibility": "public", "ordered": false }
  ],

  "cardTypes": [
    {
      "id": "hero",
      "name": "Hero",
      "isIdentity": true,
      "unique": true,
      "playableTo": ["play"],
      "attributes": [
        { "id": "health",  "name": "Health",  "type": "integer", "min": 1, "required": true, "showOnCard": "bottom-right" },
        { "id": "faction", "name": "Faction", "type": "enum", "options": ["ember", "ash"], "required": true, "showOnCard": "top-right" }
      ],
      "modifiableAttributes": ["health"],
      "abilitySlots": { "max": 2 }
    },
    {
      "id": "character",
      "name": "Character",
      "playableTo": ["play"],
      "attributes": [
        { "id": "cost",   "name": "Cost",   "type": "integer", "min": 0, "max": 10, "required": true, "showOnCard": "top-left" },
        { "id": "attack", "name": "Attack", "type": "integer", "min": 0, "required": true, "showOnCard": "bottom-left" },
        { "id": "health", "name": "Health", "type": "integer", "min": 1, "required": true, "showOnCard": "bottom-right" },
        { "id": "traits", "name": "Traits", "type": "tagList", "vocabulary": "traits", "showOnCard": "type-line" }
      ],
      "modifiableAttributes": ["attack", "health", "cost"],
      "abilitySlots": { "max": 3 }
    },
    {
      "id": "event",
      "name": "Event",
      "playableTo": ["discard"],
      "attributes": [
        { "id": "cost", "name": "Cost", "type": "integer", "min": 0, "max": 10, "required": true, "showOnCard": "top-left" }
      ],
      "modifiableAttributes": ["cost"],
      "abilitySlots": { "max": 2 }
    },
    {
      "id": "attachment",
      "name": "Attachment",
      "playableTo": ["play"],
      "attributes": [
        { "id": "cost",   "name": "Cost",   "type": "integer", "min": 0, "max": 10, "required": true, "showOnCard": "top-left" },
        { "id": "traits", "name": "Traits", "type": "tagList", "vocabulary": "traits", "showOnCard": "type-line" }
      ],
      "modifiableAttributes": ["cost"],
      "abilitySlots": { "max": 2 }
    }
  ],

  "keywords": [
    {
      "id": "swift",
      "name": "Swift",
      "reminder": "This character may attack the round it enters play.",
      "grants": [
        { "kind": "permission", "permission": "attack_while_summoning_sick", "value": true }
      ]
    },
    {
      "id": "guard",
      "name": "Guard",
      "reminder": "While this character is ready, enemy characters must attack it before any other target.",
      "grants": [
        { "kind": "restriction", "restriction": "must_be_attacked_first", "value": true }
      ]
    },
    {
      "id": "bolster",
      "name": "Bolster",
      "reminder": "When this enters play, another friendly character gets +N attack this round.",
      "parameters": [{ "id": "n", "type": "integer", "required": true }],
      "grants": [
        {
          "kind": "ability",
          "ability": {
            "id": "bolster",
            "kind": "triggered",
            "speed": "forced",
            "trigger": {
              "event": "card.entered_zone",
              "window": "after",
              "filter": {
                "op": "and",
                "of": [
                  { "op": "eq", "left": "$event.card", "right": "$self" },
                  { "op": "eq", "left": "$event.to", "right": "play" }
                ]
              }
            },
            "targets": [
              {
                "id": "ally",
                "query": { "zone": "play", "controller": "$you", "types": ["character"], "exclude": ["$self"] },
                "count": 1,
                "optional": true,
                "chooser": "$you",
                "prompt": "Choose another friendly character to bolster"
              }
            ],
            "effect": [
              {
                "op": "modify",
                "target": "$target.ally",
                "changes": [{ "attr": "attack", "mode": "add", "value": { "op": "param", "id": "n" } }],
                "duration": "round"
              }
            ],
            "text": "Bolster."
          }
        }
      ]
    }
  ],

  "setup": [
    {
      "op": "for_each_player",
      "order": "seat",
      "do": [
        { "op": "put_into_play", "card": "$deck.identity", "controller": "$player", "ready": true },
        { "op": "shuffle", "zone": "deck", "player": "$player" },
        { "op": "draw", "player": "$player", "count": 5 }
      ]
    },
    { "op": "set_first_player", "rule": "random" }
  ],

  "mulligan": { "enabled": true, "mode": "full_redraw", "times": 1 },

  "round": {
    "structure": "phased",
    "firstPlayer": { "rule": "alternate" },
    "triggerOrdering": "apnap",
    "phases": [
      {
        "id": "refresh",
        "name": "Refresh",
        "steps": [
          {
            "id": "ready",
            "name": "Ready cards",
            "auto": [
              { "op": "for_each_player", "order": "turn", "do": [{ "op": "ready_all", "zone": "play", "player": "$player" }] }
            ]
          },
          {
            "id": "income",
            "name": "Gain Ember",
            "auto": [
              {
                "op": "for_each_player",
                "order": "turn",
                "do": [
                  {
                    "op": "gain_resource",
                    "player": "$player",
                    "resource": "ember",
                    "mode": "set",
                    "amount": { "op": "min", "of": [{ "op": "add", "left": { "op": "round" }, "right": 1 }, 6] }
                  }
                ]
              }
            ]
          },
          {
            "id": "draw",
            "name": "Draw",
            "auto": [
              { "op": "for_each_player", "order": "turn", "do": [{ "op": "draw", "player": "$player", "count": 1 }] }
            ]
          }
        ]
      },
      {
        "id": "action",
        "name": "Action",
        "steps": [
          {
            "id": "main",
            "name": "Main",
            "window": { "type": "alternating", "endOn": "consecutive_passes" }
          }
        ]
      },
      {
        "id": "combat",
        "name": "Combat",
        "steps": [
          {
            "id": "declare_attackers",
            "name": "Declare attackers",
            "window": { "type": "active_player", "actions": ["declare_attack"], "skipIfNoActions": true }
          },
          {
            "id": "declare_blockers",
            "name": "Declare blockers",
            "window": { "type": "defending_player", "actions": ["declare_block"], "skipIfNoActions": true }
          },
          {
            "id": "resolve",
            "name": "Resolve combat",
            "auto": [
              {
                "op": "resolve_combat",
                "model": "simultaneous_strike",
                "damageAttr": "attack",
                "healthAttr": "health",
                "damageCounter": "damage",
                "unblockedTarget": "defending_identity"
              }
            ]
          }
        ]
      },
      {
        "id": "end",
        "name": "End",
        "steps": [
          {
            "id": "cleanup",
            "name": "Cleanup",
            "auto": [
              { "op": "expire_modifiers", "duration": "round" },
              { "op": "enforce_hand_size", "max": 7 }
            ]
          }
        ]
      }
    ]
  },

  "actions": [
    {
      "id": "play_character",
      "name": "Play a character",
      "windows": ["action.main"],
      "targets": [
        { "id": "card", "query": { "zone": "hand", "controller": "$you", "types": ["character"] }, "count": 1, "chooser": "$you" }
      ],
      "cost": [
        { "op": "pay_resource", "player": "$you", "resource": "ember", "amount": { "op": "attr", "of": "$target.card", "attr": "cost" } }
      ],
      "effect": [
        { "op": "put_into_play", "card": "$target.card", "controller": "$you", "ready": true }
      ],
      "emits": ["card.played"],
      "text": "Pay a character's cost to put it into play."
    },
    {
      "id": "play_attachment",
      "name": "Play an attachment",
      "windows": ["action.main"],
      "targets": [
        { "id": "card", "query": { "zone": "hand", "controller": "$you", "types": ["attachment"] }, "count": 1, "chooser": "$you" },
        { "id": "host", "query": { "zone": "play", "types": ["character"] }, "count": 1, "chooser": "$you", "prompt": "Choose a character to attach to" }
      ],
      "cost": [
        { "op": "pay_resource", "player": "$you", "resource": "ember", "amount": { "op": "attr", "of": "$target.card", "attr": "cost" } }
      ],
      "effect": [
        { "op": "put_into_play", "card": "$target.card", "controller": "$you", "ready": true },
        { "op": "attach", "card": "$target.card", "to": "$target.host" }
      ],
      "emits": ["card.played"],
      "text": "Pay an attachment's cost and attach it to a character."
    },
    {
      "id": "play_event",
      "name": "Play an event",
      "windows": ["action.main"],
      "targets": [
        { "id": "card", "query": { "zone": "hand", "controller": "$you", "types": ["event"] }, "count": 1, "chooser": "$you" }
      ],
      "cost": [
        { "op": "pay_resource", "player": "$you", "resource": "ember", "amount": { "op": "attr", "of": "$target.card", "attr": "cost" } }
      ],
      "effect": [
        { "op": "move_card", "card": "$target.card", "to": "discard", "controller": "$you" }
      ],
      "emits": ["card.played"],
      "text": "Pay an event's cost, resolve its ability, then put it in your discard pile."
    },
    {
      "id": "declare_attack",
      "name": "Declare an attack",
      "windows": ["combat.declare_attackers"],
      "targets": [
        {
          "id": "attacker",
          "query": {
            "zone": "play",
            "controller": "$you",
            "types": ["character"],
            "where": { "op": "not", "of": { "op": "is_exhausted", "card": "$card" } }
          },
          "count": 1,
          "chooser": "$you",
          "prompt": "Choose an attacker"
        }
      ],
      "cost": [
        { "op": "exhaust", "card": "$target.attacker" }
      ],
      "requirements": [
        {
          "op": "or",
          "of": [
            { "op": "not", "of": { "op": "entered_this_round", "card": "$target.attacker" } },
            { "op": "has_permission", "card": "$target.attacker", "permission": "attack_while_summoning_sick" }
          ]
        }
      ],
      "effect": [
        { "op": "declare_attack", "attacker": "$target.attacker" }
      ],
      "text": "Exhaust a ready character to attack."
    },
    {
      "id": "declare_block",
      "name": "Declare a block",
      "windows": ["combat.declare_blockers"],
      "targets": [
        {
          "id": "blocker",
          "query": {
            "zone": "play",
            "controller": "$you",
            "types": ["character"],
            "where": { "op": "not", "of": { "op": "is_exhausted", "card": "$card" } }
          },
          "count": 1,
          "chooser": "$you",
          "prompt": "Choose a blocker"
        },
        {
          "id": "attacker",
          "query": { "zone": "play", "controller": "$opponent", "types": ["character"] },
          "count": 1,
          "chooser": "$you",
          "prompt": "Choose the attacker to block"
        }
      ],
      "effect": [
        { "op": "declare_block", "blocker": "$target.blocker", "attacker": "$target.attacker" }
      ],
      "text": "Assign a ready character to block an attacker."
    }
  ],

  "stateChecks": [
    {
      "id": "lethal_damage",
      "scope": { "zone": "play", "types": ["character"] },
      "when": {
        "op": "gte",
        "left": { "op": "counter", "of": "$card", "counter": "damage" },
        "right": { "op": "attr", "of": "$card", "attr": "health" }
      },
      "then": [{ "op": "destroy", "card": "$card" }]
    },
    {
      "id": "hand_size",
      "scope": { "players": "all" },
      "phase": "end",
      "step": "cleanup",
      "when": {
        "op": "gt",
        "left": { "op": "zone_size", "zone": "hand", "player": "$player" },
        "right": 7
      },
      "then": [
        {
          "op": "choose_and_discard",
          "player": "$player",
          "count": {
            "op": "sub",
            "left": { "op": "zone_size", "zone": "hand", "player": "$player" },
            "right": 7
          }
        }
      ]
    }
  ],

  "winConditions": [
    {
      "id": "hero_burned",
      "scope": { "players": "all" },
      "check": {
        "op": "gte",
        "left": { "op": "counter", "of": "$player.identity", "counter": "damage" },
        "right": { "op": "attr", "of": "$player.identity", "attr": "health" }
      },
      "outcome": { "loser": "$player" },
      "text": "A player whose hero has damage equal to or greater than its health loses the game."
    },
    {
      "id": "deck_out",
      "scope": { "players": "all" },
      "trigger": "on_draw_from_empty",
      "check": {
        "op": "eq",
        "left": { "op": "zone_size", "zone": "deck", "player": "$player" },
        "right": 0
      },
      "outcome": { "loser": "$player" },
      "text": "A player who must draw from an empty deck loses the game."
    },
    {
      "id": "round_limit",
      "check": { "op": "gt", "left": { "op": "round" }, "right": 25 },
      "outcome": { "draw": true },
      "text": "If round 25 ends with no winner, the game is a draw."
    }
  ],

  "deckbuilding": {
    "deckSize": { "min": 24, "max": 30 },
    "maxCopies": 3,
    "identity": { "type": "hero", "count": 1, "zone": "play" },
    "sideboard": null,
    "constraints": [
      {
        "id": "faction_lock",
        "severity": "error",
        "rule": {
          "op": "all",
          "of": { "zone": "deck" },
          "match": {
            "op": "or",
            "of": [
              {
                "op": "eq",
                "left": { "op": "attr", "of": "$card", "attr": "faction" },
                "right": { "op": "attr", "of": "$deck.identity", "attr": "faction" }
              },
              {
                "op": "eq",
                "left": { "op": "attr", "of": "$card", "attr": "faction" },
                "right": "neutral"
              }
            ]
          }
        },
        "message": "Every card must match your hero's faction or be neutral."
      }
    ]
  },

  "ui": {
    "board": {
      "layout": "duel-mirrored",
      "rows": [
        { "id": "opponent-play", "zone": "play", "player": "$opponent", "label": "Opponent" },
        { "id": "shared-removed", "zone": "removed", "player": "$shared", "collapsed": true, "label": "Out of Play" },
        { "id": "own-play", "zone": "play", "player": "$you", "label": "You" }
      ],
      "docks": {
        "hand": "bottom",
        "deck": "bottom-right",
        "discard": "bottom-right",
        "identity": "left"
      }
    },
    "cardTemplate": "standard-portrait",
    "theme": { "accent": "#c0392b", "surface": "#191512" }
  },

  "rulesText": {
    "sections": [
      {
        "id": "overview",
        "title": "Overview",
        "body": "Two rival houses meet at the last fire. Each player commands a hero and a deck of 24 to 30 cards. Spend Ember to bring characters into play, attack with them, and reduce the enemy hero's health to zero."
      },
      {
        "id": "golden-rule",
        "title": "The Golden Rule",
        "body": "If the text of a card contradicts these rules, the card takes precedence."
      },
      {
        "id": "ready-exhaust",
        "title": "Ready and Exhausted",
        "body": "A card turned sideways is exhausted and cannot be used again until it readies. All cards ready during the Refresh phase."
      }
    ],
    "generate": ["phases", "keywords", "zones", "deckbuilding"]
  }
}
