          "effect": [{ "op": "deal_damage", "target": "$target.minion", "amount": 3, "source": "$self" }],
          "text": "Deal 3 damage to a minion engaged with you."
        }
      ],
      "text": null,
      "design": { "status": "approved", "intendedRole": "Demonstrates zonePlayer: only YOUR engaged enemies are legal targets.", "tags": ["engagement-demo"] }
    },

