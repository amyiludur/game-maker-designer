{
  "$schema": "../../../schemas/set.schema.json",
  "schemaVersion": "1.0.0",
  "code": "whcore",
  "gameId": "wardens-hollow",
  "name": "Warden's Hollow Core Set",
  "releaseOrder": 1,
  "status": "draft",
  "summary": "One Watcher, the Warden, and enough of the Hollow to run a scenario end to end.",
  "design": {
    "goals": [
      "Prove the double-sided identity and the form-flip loop",
      "Prove an engine-scripted adversary and an encounter deck",
      "Prove per-player scaling on villain health and scheme threshold"
    ],
    "budget": { "citizen": 1, "ally": 3, "event": 3, "upgrade": 2, "warden": 1, "scheme": 1, "minion": 2, "treachery": 2 }
  },

  "cards": [
    {
      "schemaVersion": "1.0.0",
      "code": "wh-001",
      "gameId": "wardens-hollow",
      "setId": "whcore",
      "number": 1,
      "faction": "watch",
      "rarity": "rare",
      "quantity": 1,
      "sides": {
        "front": {
          "name": "Aria Vance",
          "type": "citizen",
          "attributes": { "health": 11, "recover": 4, "form": "citizen" },
          "abilities": [
            {
              "id": "a1",
              "kind": "activated",
              "speed": "action",
              "cost": [{ "op": "exhaust", "card": "$self" }],
              "effect": [{ "op": "draw", "player": "$you", "count": 1 }],
              "limit": { "perRound": 1 },
              "text": "Exhaust: Draw a card. Limit once per round."
            }
          ],
          "text": null,
          "flavor": "Nobody looks twice at the lamplighter's daughter."
        },
        "back": {
          "name": "Nightjar",
          "type": "guardian",
          "attributes": { "health": 11, "attack": 2, "thwart": 2, "form": "guardian" },
          "abilities": [
            {
              "id": "a1",
              "kind": "triggered",
              "speed": "forced",
              "trigger": {
                "event": "card.flipped",
                "filter": {
                  "op": "and",
                  "of": [
                    { "op": "eq", "left": "$event.card", "right": "$self" },
                    { "op": "eq", "left": "$event.to", "right": "back" }
                  ]
                }
              },
              "effect": [
                {
                  "op": "remove_counter",
                  "card": "$adversary.mainScheme",
                  "counter": "threat",
                  "amount": 1
                }
              ],
              "text": "When you change to Nightjar, remove 1 threat from the main scheme."
            }
          ],
          "text": null,
          "flavor": "The lamps go out one street ahead of her."
        }
      },
      "design": {
        "status": "approved",
        "intendedRole": "Demonstrates a double-sided identity where each face has its own type, attributes and abilities.",
        "tags": ["identity", "double-sided"]
      }
    },

