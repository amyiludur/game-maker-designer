{
    "name": "@gmd/web",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc --noEmit && vite build",
        "preview": "vite preview",
        "typecheck": "vue-tsc --noEmit",
        "test": "vitest run",
        "types": "node scripts/generate-types.mjs",
        "types:check": "node scripts/generate-types.mjs && git diff --exit-code -- src/api/documents.gen.d.ts",
        "e2e": "playwright test",
        "lint": "eslint . && prettier --check src e2e",
        "lint:fix": "eslint . --fix && prettier --write src e2e"
    },
    "dependencies": {
        "pinia": "^2.2.6",
        "vue": "^3.5.13",
        "vue-router": "^4.4.5"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.62.1",
        "@types/node": "^22.10.1",
        "@vitejs/plugin-vue": "^5.2.1",
        "@vue/test-utils": "^2.4.6",
        "eslint": "^10.9.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.10.0",
        "globals": "^17.12.0",
        "happy-dom": "^15.11.6",
        "json-schema-to-typescript": "^15.0.3",
        "prettier": "^3.9.6",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.69.0",
        "vite": "^6.0.3",
        "vitest": "^3.2.7",
        "vue-eslint-parser": "^10.4.1",
        "vue-tsc": "^2.1.10"
    }
}
