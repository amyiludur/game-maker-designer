{
    "name": "gmd/monorepo",
    "description": "Game Maker Designer \u2014 an LCG design, authoring, balancing and playtesting platform.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "gmd/harness": "*",
        "gmd/kernel": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "opis/json-schema": "^2.3",
        "pestphp/pest": "^3.0 || ^4.0 || ^5.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/kernel",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "packages/harness",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload-dev": {
        "psr-4": {
            "Gmd\\Kernel\\Tests\\": "packages/kernel/tests/",
            "Gmd\\Harness\\Tests\\": "packages/harness/tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "pest",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix"
    }
}
